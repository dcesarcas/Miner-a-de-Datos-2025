cluster_gastro <- kmeans(datos_gastro_cluster, centers = 2)

datos_gastro_cluster$deptoresiden <- factor(datos_gastro_cluster$deptoresiden)


ggplot(datos_gastro_cluster, aes(x = mes, y = deptoresiden, color =as.factor(cluster_gastro$cluster)))+
  geom_point()+
  geom_point(data = as.data.frame(cluster_gastro$centers), aes(x = mes, y = deptoresiden), color="black", size=4, shape=17)+
  labs(title = "Meses vs departamentos de los casos") +
  theme_minimal()


#Caso 2: Segmentación por Edad y Causa de Atención

set.seed(123) 
muestra <- datos[sample(1:nrow(datos), 40000), c("sexo", "causa_atencion","periodo_edad", "deptoresiden", "tipo_consulta")]
muestra_num <- data.frame(
  sexo           = as.numeric(muestra$sexo),
  causa_atencion = as.numeric(muestra$causa_atencion),
  periodo_edad   = as.numeric(muestra$periodo_edad),
  deptoresiden   = as.numeric(muestra$deptoresiden),
  tipo_consulta  = as.numeric(muestra$tipo_consulta)
)
set.seed(123) 
kmeans_model <- kmeans(muestra_num, centers = 4, nstart = 25)
muestra$cluster <- factor(kmeans_model$cluster)
library(ggplot2)
ggplot(muestra, aes(x = periodo_edad, y = causa_atencion, color = cluster)) +
  geom_jitter(alpha = 0.3, width = 0.2, height = 0.2) +
  labs(title = "Clusters de K-means: Causa vs. Periodo de Edad",
       x = "Periodo de Edad", y = "Causa de Atención") +
  theme_minimal()

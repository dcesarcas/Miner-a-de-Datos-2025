#PARTE 3 CLUSTER
#Caso 1: Casos de Gastroenteritis según Mes y Departamento
datos_gastro_cluster <- subset(datos, causa_atencion ==  "A099")
datos_gastro_cluster <- subset(datos_gastro_cluster, deptoresiden != 99)
datos_gastro_cluster <- subset(datos_gastro_cluster, periodo_edad == 3)
datos_gastro_cluster <- datos_gastro_cluster[,c("edad","mes","deptoresiden", "tipo_consulta","ano","pueblo_pertenencia")]
